from datetime import datetime
def logpgm(logfile,cond):
    dt=datetime.today()
    dts=str(dt)+'\n'
    if cond==0:
        ps='program started'+'\n'
    else:
        ps='program endend'+'\n'
        logfile.write(ps)
        logfile.write(dts)
        return
def openfiles():
    filein='C:/data/ptest/testfile7.txt'
